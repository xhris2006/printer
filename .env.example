# Print & Secrétariat — variables d'environnement
# Chaque application possède son propre fichier d'exemple détaillé :
#   backend/.env.example   → API Express (Railway)
#   frontend/.env.example  → Next.js (Vercel)
# Copiez-les en backend/.env et frontend/.env.local pour le développement.

# ───────────── Backend (extrait des variables essentielles) ─────────────
DATABASE_URL=postgresql://printer:printer@localhost:5432/printer_dev?schema=public
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
APP_SECRET=                       # >= 32 caractères en production (openssl rand -base64 48)
STORAGE_DRIVER=local              # local | s3
PAYMENT_PROVIDER=mock             # fapshi | mock (développement uniquement) | none
FAPSHI_ENV=sandbox                # sandbox | live
FAPSHI_API_USER=
FAPSHI_API_KEY=
FAPSHI_WEBHOOK_SECRET=
SMTP_HOST=                        # facultatif : notifications par email
SUPPORT_WHATSAPP=+237694600007

# ───────────── Frontend ─────────────
BACKEND_URL=http://localhost:4000 # utilisé par les rewrites /api/* au build
NEXT_PUBLIC_SUPPORT_WHATSAPP=+237694600007
