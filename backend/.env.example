# ───────────── API Print & Secrétariat (backend) ─────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL (Railway : utilisez la variable ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://printer:printer@localhost:5432/printer_dev?schema=public

# URL(s) du frontend autorisée(s) (CORS + liens dans les emails), séparées par des virgules
FRONTEND_URL=http://localhost:3000
# URL publique de cette API (liens de téléversement/téléchargement du stockage local, Swagger)
API_PUBLIC_URL=http://localhost:4000
# Secret applicatif (>= 32 caractères, OBLIGATOIRE en production) : openssl rand -base64 48
APP_SECRET=
# Nombre de proxys de confiance (Railway = 1 ; Vercel → Railway = 2)
TRUST_PROXY=1
SESSION_TTL_DAYS=30

# ───────────── Stockage des documents (privé) ─────────────
# local = disque (développement ou volume Railway) ; s3 = stockage compatible S3 (recommandé en production)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ───────────── Paiement Fapshi ─────────────
# fapshi | mock (simulateur, interdit en production) | none (paiement en ligne désactivé)
PAYMENT_PROVIDER=mock
# sandbox (https://sandbox.fapshi.com) | live (https://live.fapshi.com)
FAPSHI_ENV=sandbox
FAPSHI_API_USER=
FAPSHI_API_KEY=
# Secret défini dans le tableau de bord Fapshi (envoyé dans l'en-tête x-wh-secret)
FAPSHI_WEBHOOK_SECRET=
# true uniquement si Fapshi a activé le paiement direct (direct-pay) sur votre compte
FAPSHI_DIRECT_PAY_ENABLED=false
ALLOW_SANDBOX_IN_PRODUCTION=false

# ───────────── Notifications ─────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Print & Secrétariat <no-reply@votre-domaine.cm>"
# Aucun fournisseur WhatsApp Business n'est branché : aucun message WhatsApp automatique
WHATSAPP_PROVIDER=none
SUPPORT_WHATSAPP=+237694600007

# ───────────── Traitement des documents ─────────────
LIBREOFFICE_PATH=soffice
CONVERSION_TIMEOUT_MS=120000
# Antivirus optionnel (clamd)
CLAMAV_HOST=
CLAMAV_PORT=3310
# Tests E2E locaux uniquement : désactive la limitation de débit (ignoré en production)
DISABLE_RATE_LIMIT=false
# Worker intégré à l'API (true) ou processus séparé `npm run start:worker` (false)
WORKER_INLINE=true
WORKER_CONCURRENCY=2
